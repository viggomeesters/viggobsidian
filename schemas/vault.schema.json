{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/viggomeesters/viggobsidian/blob/main/schemas/vault.schema.json",
  "title": "ViggObsidian vault integration",
  "type": "object",
  "required": ["schema", "profile", "adoption", "local_adapter"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "viggobsidian.integration.v1"},
    "profile": {"const": "numbered-v1"},
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"legacy_project_roots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"}}}
    },
    "local_adapter": {"const": ".viggobsidian/local-adapter.md"}
  }
}
